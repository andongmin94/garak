{
  "name": "@garak/product-compiler",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write src tests package.json tsconfig.json eslint.config.mjs",
    "format:check": "prettier --check src tests package.json tsconfig.json eslint.config.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test --test-isolation=none --test-concurrency=1 tests/*.test.ts"
  },
  "dependencies": {},
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "eslint": "10.8.1",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0"
  }
}
