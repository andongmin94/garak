{
  "name": "garak",
  "private": true,
  "packageManager": "pnpm@11.16.0",
  "scripts": {
    "product:validate": "node tools/product-compiler/src/cli.ts validate",
    "product:inspect": "node tools/product-compiler/src/cli.ts inspect",
    "product:compile": "node tools/product-compiler/src/cli.ts compile",
    "product:export": "node tools/product-compiler/src/cli.ts export",
    "product:lint": "pnpm --dir tools/product-compiler lint",
    "product:format": "pnpm --dir tools/product-compiler format",
    "product:format:check": "pnpm --dir tools/product-compiler format:check",
    "product:typecheck": "pnpm --dir tools/product-compiler typecheck",
    "product:test": "pnpm --dir tools/product-compiler test",
    "studio:dev": "pnpm --dir studio dev",
    "studio:lint": "pnpm --dir studio lint",
    "studio:format": "pnpm --dir studio format",
    "studio:format:check": "pnpm --dir studio format:check",
    "studio:typecheck": "pnpm --dir studio typecheck",
    "studio:build": "pnpm --dir studio build"
  }
}
