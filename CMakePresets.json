{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": true,
        "GARAK_BUILD_TESTS": true
      }
    },
    {
      "name": "debug",
      "displayName": "Debug",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release",
      "displayName": "Release",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "debug-warnings-as-errors",
      "displayName": "Debug with warnings as errors",
      "inherits": "debug",
      "cacheVariables": {
        "GARAK_WARNINGS_AS_ERRORS": true
      }
    },
    {
      "name": "debug-clang-tidy",
      "displayName": "Debug with clang-tidy",
      "inherits": "debug",
      "cacheVariables": {
        "GARAK_ENABLE_CLANG_TIDY": true
      }
    },
    {
      "name": "vst3-debug",
      "displayName": "VST3 Gain Spike Debug",
      "inherits": "debug",
      "cacheVariables": {
        "GARAK_BUILD_VST3_GAIN_SPIKE": true
      }
    },
    {
      "name": "vst3-release",
      "displayName": "VST3 Gain Spike Release",
      "inherits": "release",
      "cacheVariables": {
        "GARAK_BUILD_VST3_GAIN_SPIKE": true
      }
    },
    {
      "name": "vst3-werror",
      "displayName": "VST3 Gain Spike Debug with warnings as errors",
      "inherits": "vst3-debug",
      "cacheVariables": {
        "GARAK_WARNINGS_AS_ERRORS": true
      }
    },
    {
      "name": "vst3-clang-tidy",
      "displayName": "VST3 Gain Spike Debug with clang-tidy",
      "inherits": "vst3-debug",
      "cacheVariables": {
        "GARAK_ENABLE_CLANG_TIDY": true
      }
    },
    {
      "name": "runtime-strategy-debug",
      "displayName": "Runtime Strategy Spike Debug",
      "inherits": "debug",
      "cacheVariables": {
        "GARAK_BUILD_VST3_GAIN_SPIKE": true,
        "GARAK_BUILD_RUNTIME_STRATEGY_SPIKE": true
      }
    },
    {
      "name": "runtime-strategy-release",
      "displayName": "Runtime Strategy Spike Release",
      "inherits": "release",
      "cacheVariables": {
        "GARAK_BUILD_VST3_GAIN_SPIKE": true,
        "GARAK_BUILD_RUNTIME_STRATEGY_SPIKE": true
      }
    },
    {
      "name": "runtime-strategy-werror",
      "displayName": "Runtime Strategy Spike Debug with warnings as errors",
      "inherits": "runtime-strategy-debug",
      "cacheVariables": {
        "GARAK_WARNINGS_AS_ERRORS": true
      }
    },
    {
      "name": "runtime-strategy-clang-tidy",
      "displayName": "Runtime Strategy Spike Debug with clang-tidy",
      "inherits": "runtime-strategy-debug",
      "cacheVariables": {
        "GARAK_ENABLE_CLANG_TIDY": true
      }
    },
    {
      "name": "product-runtime-debug",
      "displayName": "Product Runtime v1 Debug",
      "inherits": "debug",
      "cacheVariables": {
        "GARAK_BUILD_VST3_GAIN_SPIKE": true,
        "GARAK_BUILD_RUNTIME_STRATEGY_SPIKE": true,
        "GARAK_BUILD_PRODUCT_RUNTIME_V1": true
      }
    },
    {
      "name": "product-runtime-release",
      "displayName": "Product Runtime v1 Release",
      "inherits": "release",
      "cacheVariables": {
        "GARAK_BUILD_VST3_GAIN_SPIKE": true,
        "GARAK_BUILD_RUNTIME_STRATEGY_SPIKE": true,
        "GARAK_BUILD_PRODUCT_RUNTIME_V1": true
      }
    },
    {
      "name": "product-runtime-werror",
      "displayName": "Product Runtime v1 Debug with warnings as errors",
      "inherits": "product-runtime-debug",
      "cacheVariables": {
        "GARAK_WARNINGS_AS_ERRORS": true
      }
    },
    {
      "name": "product-runtime-clang-tidy",
      "displayName": "Product Runtime v1 Debug with clang-tidy",
      "inherits": "product-runtime-debug",
      "cacheVariables": {
        "GARAK_ENABLE_CLANG_TIDY": true
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug-build",
      "configurePreset": "debug"
    },
    {
      "name": "release-build",
      "configurePreset": "release"
    },
    {
      "name": "warnings-as-errors-build",
      "configurePreset": "debug-warnings-as-errors"
    },
    {
      "name": "clang-tidy-build",
      "configurePreset": "debug-clang-tidy"
    },
    {
      "name": "vst3-debug-build",
      "configurePreset": "vst3-debug",
      "targets": ["garak_vst3_gain_spike_all"]
    },
    {
      "name": "vst3-release-build",
      "configurePreset": "vst3-release",
      "targets": ["garak_vst3_gain_spike_all"]
    },
    {
      "name": "vst3-werror-build",
      "configurePreset": "vst3-werror",
      "targets": ["garak_vst3_gain_spike_all"]
    },
    {
      "name": "vst3-clang-tidy-build",
      "configurePreset": "vst3-clang-tidy",
      "targets": ["garak_vst3_gain_spike_all"]
    },
    {
      "name": "runtime-strategy-debug-build",
      "configurePreset": "runtime-strategy-debug",
      "targets": ["garak_runtime_strategy_spike_all"]
    },
    {
      "name": "runtime-strategy-release-build",
      "configurePreset": "runtime-strategy-release",
      "targets": ["garak_runtime_strategy_spike_all"]
    },
    {
      "name": "runtime-strategy-werror-build",
      "configurePreset": "runtime-strategy-werror",
      "targets": ["garak_runtime_strategy_spike_all"]
    },
    {
      "name": "runtime-strategy-clang-tidy-build",
      "configurePreset": "runtime-strategy-clang-tidy",
      "targets": ["garak_runtime_strategy_spike_all"]
    },
    {
      "name": "product-runtime-debug-build",
      "configurePreset": "product-runtime-debug",
      "targets": ["garak_product_runtime_v1_all"]
    },
    {
      "name": "product-runtime-release-build",
      "configurePreset": "product-runtime-release",
      "targets": ["garak_product_runtime_v1_all"]
    },
    {
      "name": "product-runtime-werror-build",
      "configurePreset": "product-runtime-werror",
      "targets": ["garak_product_runtime_v1_quality"]
    },
    {
      "name": "product-runtime-clang-tidy-build",
      "configurePreset": "product-runtime-clang-tidy",
      "targets": ["garak_product_runtime_v1_quality"]
    }
  ],
  "testPresets": [
    {
      "name": "debug-test",
      "configurePreset": "debug",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "release-test",
      "configurePreset": "release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "vst3-debug-test",
      "configurePreset": "vst3-debug",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "vst3-release-test",
      "configurePreset": "vst3-release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "runtime-strategy-debug-test",
      "configurePreset": "runtime-strategy-debug",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "runtime-strategy-release-test",
      "configurePreset": "runtime-strategy-release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "product-runtime-debug-test",
      "configurePreset": "product-runtime-debug",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "product-runtime-release-test",
      "configurePreset": "product-runtime-release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    }
  ]
}
